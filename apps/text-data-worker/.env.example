LOGGER_LEVEL=INFO
NATS_HOST=aipm-nats
NATS_PORT=4222

DATABASE_URL=postgresql://postgres:password@aipm-pg:5432/aipm

# deepseek | openai | ollama
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=your_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# host.docker.internal — обращение к Ollama на хосте из Docker-контейнера
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5

CONTEXT_FILE_PATH=/data/context.json
CONTEXT_MAX_MESSAGES=30
